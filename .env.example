# Copy this file to ".env" and (optionally) paste a free Gemini API key.
#
# Get a key for free (no credit card) at:
#   https://aistudio.google.com/app/apikey
#
# Lumen also works with NO key: it falls back to keyword routing and template
# answers while still fetching real data from the public APIs. A key just makes
# the answers read more naturally.

GEMINI_API_KEY=

# --- Optional settings (safe to leave blank) ---

# The homework asked for gemini-2.5-flash-lite. If Google retires that model for
# your key, set any current free-tier flash model here instead.
# GEMINI_MODEL=gemini-2.5-flash-lite

# Web server host/port.
# HOST=127.0.0.1
# PORT=5000
